# Dependencies
/node_modules

# Next.js: the build, a static export, and the type file `pnpm typecheck` writes
/.next/
/out/
next-env.d.ts

# Tests and types
/coverage
*.tsbuildinfo

# Secrets stay on the machine that has them
.env*
!.env.example

# The agentcfg binary `pnpm agentcfg` fetches. Downloaded per pin, never
# committed — Renovate collects post-upgrade changes from `git status`, so an
# unignored copy would land three megabytes in a pull request about prose.
/.agentcfg/

# Logs and editor droppings
*.log
.DS_Store
